{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cerro-largo-api-cloud-2",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f2857278e52c47fba8226b0d999e0bb5"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "APP_PUBLIC_URL": "https://cerrolargo360.vercel.app",
    "APP_ORIGINS": "https://cerrolargo360.vercel.app,https://cerro-largo-360-cloud-2.vercel.app",
    "GOOGLE_REDIRECT_URI": "https://cerro-largo-360-cloud-2.vercel.app/api/auth/google",
    "MAIL_MODE": "gmail",
    "SUPABASE_STORAGE_BUCKET": "cerro-largo-files"
  }
}
