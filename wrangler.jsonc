{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cerro-largo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cerro-largo",
      "database_id": "ca0a3c08-56a4-4a09-adb2-4dd748f9e9bf",
      "migrations_dir": "migrations/d1"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "APP_PUBLIC_URL": "https://frontend-baa4tscpm.vercel.app",
    "APP_ORIGINS": "https://frontend-baa4tscpm.vercel.app",
    "SUPABASE_STORAGE_BUCKET": "cerro-largo-files",
    "GOOGLE_REDIRECT_URI": "https://frontend-baa4tscpm.vercel.app/api/auth/google"
  },
  "observability": {
    "enabled": true
  }
}
