# Copiá este archivo a .env y completá los valores privados.

# Entorno
NODE_ENV=development

# PostgreSQL para Prisma CLI. Wrangler usa .dev.vars al ejecutar el Worker local.
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/cerrolargo
# Para migrar Supabase, copiá la conexión directa o el pooler en modo sesión.
# DIRECT_URL=postgresql://postgres.REF:TU_CONTRASENA@HOST:5432/postgres?sslmode=verify-full

# Aplicación y sesión
# APP_PUBLIC_URL es el origen del frontend para OAuth y enlaces de recuperación.
APP_PUBLIC_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reemplazá este valor por un secreto privado aleatorio de al menos 32 caracteres.
COOKIE_SECRET=REEMPLAZAR_POR_UN_SECRETO_PRIVADO_ALEATORIO

# Cloudflare Turnstile. Usá el secreto que corresponde a la clave pública del frontend.
TURNSTILE_SECRET_KEY=
# Opcional. Nombre de host del frontend, sin protocolo ni puerto.
TURNSTILE_HOSTNAME=

# Correo de verificación y recuperación. Cambiá MAIL_MODE a gmail para enviar.
MAIL_MODE=disabled
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME="Cerro Largo 360"

# Google OAuth opcional
GOOGLE_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google

# Directorio privado de fotos de perfil, opcional
# TURISTA_PHOTO_DIR=privado/perfiles

# Si se configuran, el backend local también utiliza Supabase Storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=cerro-largo-files
