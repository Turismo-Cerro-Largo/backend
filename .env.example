# Copiá este archivo a .env y completá los valores privados.

# Entorno
NODE_ENV=development

# MySQL. Usá la misma base en DATABASE_URL y DATABASE_*.
# Codificá los caracteres especiales de la contraseña en DATABASE_URL.
DATABASE_URL=mysql://root:TU_CONTRASENA@localhost:3306/cerrolargo
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=TU_CONTRASENA
DATABASE_NAME=cerrolargo

# Aplicación y sesión
# APP_PUBLIC_URL es el origen del frontend para OAuth y enlaces de recuperación.
APP_PUBLIC_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reemplazá este valor por un secreto privado aleatorio de al menos 32 caracteres.
COOKIE_SECRET=REEMPLAZAR_POR_UN_SECRETO_PRIVADO_ALEATORIO

# Cloudflare Turnstile. Usá el secreto que corresponde a la clave pública del frontend.
TURNSTILE_SECRET_KEY=
# Opcional. Nombre de host del frontend, sin protocolo ni puerto.
TURNSTILE_HOSTNAME=

# Correo de verificación y recuperación. Cambiá MAIL_MODE a gmail para enviar.
MAIL_MODE=disabled
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME="Cerro Largo 360"

# Google OAuth opcional
GOOGLE_ID=
GOOGLE_SECRET=

# Directorio privado de fotos de perfil, opcional
# TURISTA_PHOTO_DIR=privado/perfiles
