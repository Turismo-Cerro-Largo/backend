# Desarrollo local. Copiar a .env y completar los valores privados.
NODE_ENV=development

# Prisma y la conexion de la app deben apuntar a la misma base.
# Codificar caracteres especiales del usuario/password en DATABASE_URL.
DATABASE_URL=mysql://cerrolargo:CAMBIAR_PASSWORD@localhost:3306/cerrolargo
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=cerrolargo
DATABASE_PASSWORD=CAMBIAR_PASSWORD
DATABASE_NAME=cerrolargo

# Reemplazar por un secreto aleatorio privado de al menos 32 caracteres.
COOKIE_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES

# Backend: puerto 4000. Frontend: puerto 5173.
# APP_PUBLIC_URL tambien es el destino tras ingresar con Google.
APP_PUBLIC_URL=http://localhost:5173
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo desactivado hasta configurar Gmail y su password de aplicacion.
MAIL_MODE=disabled
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Cerro Largo 360

# OAuth opcional. Configurar las credenciales del proyecto de Google.
GOOGLE_ID=
GOOGLE_SECRET=

# Opcional: directorio privado de fotos de perfil.
# TURISTA_PHOTO_DIR=privado/perfiles
