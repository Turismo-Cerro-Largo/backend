generator client {
  provider = "prisma-client"
  runtime = "cloudflare"
  output   = "../src/configuracion/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id               Int       @id @default(autoincrement())
  nombres          String
  apellidos        String
  email            String    @unique
  departamento     String?
  localidad        String?
  foto_perfil      String?
  fecha_nacimiento DateTime?
  telefono         String?
  genero           Genero?
  cedula           String?   @unique
  passhash         String?
  rol              Rol       @default(TURISTA)
  sub              String?   @unique
  creado_en        DateTime  @default(now())

  comentarios    Comentario[]
  favoritos      Favorito[]
  recuperaciones SolicitudRecuperacion[]

  @@index([email])
  @@index([departamento])
  @@map("usuario")
}

model Organizador {
  id                  Int                     @id @default(autoincrement())
  nombre_organizacion String
  rut_ruc             String?                 @unique
  departamento     String?
  email               String                  @unique
  telefono            String
  sitio_web           String?
  passhash            String
  estado              EstadoOrganizador       @default(PENDIENTE_REVISION)
  motivo_rechazo      String?
  creado_en           DateTime                @default(now())
   acepta_terminos    Boolean   @default(false)
  acepta_privacidad  Boolean   @default(false)
  version_documentos String?
  aceptado_en        DateTime?
  documentos          DocumentoOrganizador[]
  eventos             Evento[]
  recuperaciones      SolicitudRecuperacion[]

  @@index([email])
  @@index([estado])
  @@map("organizador")
}

model DocumentoOrganizador {
  id             Int           @id @default(autoincrement())
  uri            String
  tipo           DocumentoTipo
  creado_en      DateTime      @default(now())
  id_organizador Int
  organizador    Organizador   @relation(fields: [id_organizador], references: [id], onDelete: Cascade)

  @@index([id_organizador])
  @@map("documento_organizador")
}

model Categoria {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique
  descripcion String?
  eventos     Evento[]
  ubicaciones Ubicacion[]

  @@map("categoria")
}

model Localidad {
  id             Int             @id @default(autoincrement())
  slug           String          @unique
  nombre         String          @unique
  descripcion    String?
  latitud        Float?
  longitud       Float?
  icono          String?
  estado         EstadoContenido @default(PUBLICADO)
  creado_en      DateTime        @default(now())
  actualizado_en DateTime        @updatedAt

  @@index([estado, nombre])
  @@map("localidad")
}
model Ubicacion {
  id           Int             @id @default(autoincrement())
  nombre       String
  descripcion  String
  direccion    String?
  localidad    String
  telefono     String?
  sitio_web    String?
  horario      String?
  latitud      Float
  longitud     Float
  estado       EstadoContenido @default(PUBLICADO)
  creado_en    DateTime        @default(now())
  id_categoria Int
  comentarios  Comentario[]
  favoritos    Favorito[]
  recursos     Recurso[]
  categoria    Categoria       @relation(fields: [id_categoria], references: [id])

  @@index([nombre])
  @@index([localidad])
  @@index([id_categoria, estado])
  @@map("ubicacion")
}

model Recurso {
  id            Int         @id @default(autoincrement())
  uri           String
  tipo          RecursoTipo @default(IMAGEN)
  descripcion   String?
  orden         Int         @default(0)
  id_ubicacion  Int?
  id_evento     Int?
  id_comentario Int?
  comentario    Comentario? @relation(fields: [id_comentario], references: [id], onDelete: Cascade)
  evento        Evento?     @relation(fields: [id_evento], references: [id], onDelete: Cascade)
  ubicacion     Ubicacion?  @relation(fields: [id_ubicacion], references: [id], onDelete: Cascade)

  @@index([id_ubicacion])
  @@index([id_evento])
  @@index([id_comentario])
  @@map("recurso")
}

model Comentario {
  id           Int              @id @default(autoincrement())
  texto        String?
  calificacion Int
  estado       EstadoComentario @default(PENDIENTE_REVISION)
  creado_en    DateTime         @default(now())
  id_usuario   Int
  id_ubicacion Int
  ubicacion    Ubicacion        @relation(fields: [id_ubicacion], references: [id], onDelete: Cascade)
  usuario      Usuario          @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
  recursos     Recurso[]

  @@unique([id_usuario, id_ubicacion])
  @@index([id_ubicacion, estado])
  @@index([id_usuario])
  @@map("comentario")
}

model Favorito {
  id           Int       @id @default(autoincrement())
  creado_en    DateTime  @default(now())
  id_usuario   Int
  id_ubicacion Int
  ubicacion    Ubicacion @relation(fields: [id_ubicacion], references: [id], onDelete: Cascade)
  usuario      Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@unique([id_usuario, id_ubicacion])
  @@index([id_usuario])
  @@index([id_ubicacion])
  @@map("favorito")
}

model Evento {
  id             Int          @id @default(autoincrement())
  titulo         String
  descripcion    String
  inicio         DateTime
  fin            DateTime?
  lugar_evento   String?
  latitud        Float?
  longitud       Float?
  es_gratuito    Boolean      @default(false)
  precio         Decimal?
  contacto       String?
  estado         EstadoEvento @default(BORRADOR)
  motivo_rechazo String?
  creado_en      DateTime     @default(now())
  actualizado_en DateTime     @updatedAt
  id_organizador Int
  id_categoria   Int
  categoria      Categoria    @relation(fields: [id_categoria], references: [id])
  organizador    Organizador  @relation(fields: [id_organizador], references: [id])
  recursos       Recurso[]

  @@index([estado, inicio])
  @@index([id_organizador])
  @@index([id_categoria])
  @@map("evento")
}

model SolicitudRecuperacion {
  id               Int          @id @default(autoincrement())
  token            String       @unique
  creado_en        DateTime     @default(now())
  fecha_expiracion DateTime
  usado            Boolean      @default(false)
  id_usuario       Int?
  id_organizador   Int?
  organizador      Organizador? @relation(fields: [id_organizador], references: [id], onDelete: Cascade)
  usuario          Usuario?     @relation(fields: [id_usuario], references: [id], onDelete: Cascade)

  @@index([fecha_expiracion])
  @@index([id_usuario])
  @@index([id_organizador])
  @@map("solicitud_recuperacion")
}

model EmpresaTransporte {
  id        Int              @id @default(autoincrement())
  nombre    String           @unique
  telefono  String?
  sitio_web String?
  horarios  HorarioOmnibus[]

  @@map("empresa_transporte")
}

model HorarioOmnibus {
  id            Int                    @id @default(autoincrement())
  origen        String
  destino       String
  hora_salida   DateTime
  hora_llegada  DateTime?
  dias          String
  tipo_servicio TipoServicioTransporte
  precio        Decimal?
  estado        EstadoContenido        @default(PUBLICADO)
  id_empresa    Int
  empresa       EmpresaTransporte      @relation(fields: [id_empresa], references: [id], onDelete: Cascade)

  @@index([origen, destino])
  @@index([id_empresa])
  @@index([tipo_servicio])
  @@index([estado])
  @@map("horario_omnibus")
}

enum Rol {
  TURISTA
  ADMINISTRADOR
}

enum Genero {
  masculino
  femenino
  otro
}

enum RecursoTipo {
  VIDEO
  IMAGEN
}

enum EstadoContenido {
  PUBLICADO
  OCULTADO
}

enum EstadoComentario {
  PENDIENTE_REVISION
  PUBLICADO
  OCULTADO
}

enum EstadoEvento {
  BORRADOR
  PENDIENTE_REVISION
  PUBLICADO
  RECHAZADO
  CANCELADO
  FINALIZADO
}

enum EstadoOrganizador {
  PENDIENTE_REVISION
  APROBADO
  RECHAZADO
}

enum DocumentoTipo {
  CEDULA_FRENTE
  CEDULA_DORSO
  OTRO
}

enum TipoServicioTransporte {
  DEPARTAMENTAL
  INTERDEPARTAMENTAL
}
